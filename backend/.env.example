PORT=5552
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# If you open the dev frontend from another device, add that origin too.
# Example: CORS_ORIGIN=http://localhost:5173,http://192.168.1.20:5173
MIKMOK_PASSWORD=changeme
REMOTE_SOURCE_SECRET=changeme
ALLOWED_MOUNT_ROOTS=/mounts
SESSION_TTL_DAYS=7
MAX_UPLOAD_SIZE_MB=500
TRANSCODE_ENABLED=1
# Hardware transcode (Intel QSV, requires GPU device passthrough in compose).
# Set to "libx264" only if you accept software encoding (can saturate weak NAS CPUs).
TRANSCODE_CODEC=qsv
TRANSCODE_QSV_DEVICE=/dev/dri/renderD128
